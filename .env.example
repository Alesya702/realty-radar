# Realty Radar configuration (environment variables, prefix RR_).
# Copy to .env for local development: `cp .env.example .env`.
# Real environment variables take precedence over .env.
# Keep in sync with src/platform/config/config.go.

# Environment: local | test | production
RR_ENV=local

# Logging: level debug | info | warn | error; format text | json
RR_LOG_LEVEL=info
RR_LOG_FORMAT=text

# HTTP server
# Bound to the loopback interface: the MVP has no authentication (A-02).
RR_HTTP_ADDR=127.0.0.1:8080
RR_HTTP_SHUTDOWN_TIMEOUT=10s

# PostgreSQL (matches docker-compose.yml). Required.
RR_DATABASE_URL=postgres://realtyradar:realtyradar@localhost:5432/realtyradar?sslmode=disable
RR_DATABASE_MAX_CONNS=10

# Dedicated database for integration tests (migrations are rolled back to zero).
# Used only by `go test -tags integration`, not by the application.
RR_TEST_DATABASE_URL=postgres://realtyradar:realtyradar@localhost:5432/realtyradar_test?sslmode=disable
